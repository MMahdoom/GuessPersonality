# Optional: Add your free Firebase Realtime Database config for cross-device sync
# (No login/sign-in required — sessions are locked to the 6-char room code and auto-expire after 60 mins).
# If left blank, the app runs in local multi-tab BroadcastChannel mode for instant testing.
VITE_FIREBASE_API_KEY=YOUR_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0230335730.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://gen-lang-client-0230335730-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0230335730
VITE_FIREBASE_APP_ID=YOUR_WEB_APP_ID

